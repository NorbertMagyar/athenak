# AthenaK input for homogeneous driven MHD turbulence (run A)

<comment>
problem = mhd_forced_box run A (homogeneous density)

<job>
basename = forcedA

<mesh>
nghost = 2
nx1    = 64
x1min  = 0.0
x1max  = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 64
x2min  = 0.0
x2max  = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3    = 64
x3min  = 0.0
x3max  = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 1.0
ndiag      = 1

<mhd>
eos               = ideal
gamma             = 1.6666666666667
reconstruct       = plm
rsolver           = hlld
viscosity         = 1.0e-3
ohmic_resistivity = 1.0e-3

<problem>
rho0                = 1.0
beta                = 0.1
p0                  = -1.0   # set automatically from beta and B0 when negative
B0                  = 1.0
density_variations  = false
density_eps         = 0.2

<turb_driving>
type                = mhd
nlow                = 1
nhigh               = 2
tcorr               = 0.5
dedt                = 0.001
control             = power   # alternative: accel
accel_rms           = 0.1     # used when control = accel
solenoidal_fraction = 1.0
zplus_fraction = 1.0
alfvenic_rho0 = 1.0
alfvenic_drive = true 
seed = 1349

<output1>
file_type   = hst
dt          = 0.10

<output2>
file_type   = bin
variable    = mhd_divb
dt          = 0.1
#slice_x2    = 0.0	
file_number = 0

<output3>
file_type   = bin
variable    = mhd_w_bcc
dt          = 0.1
file_number = 0
